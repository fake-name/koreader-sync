[Unit]
Description=Refresh KOReader book mappings and pull newer reading positions
After=koreader-sync.service

[Service]
Type=oneshot
User=herp
WorkingDirectory=/opt/koreader-sync
Environment=PYTHONUNBUFFERED=1
EnvironmentFile=-/etc/default/koreader-sync-mappings
ExecStart=/usr/local/bin/kosync-map-scan
UMask=0077
TimeoutStartSec=30min
# Invalid individual files are reported; the rest of the batch can succeed.
SuccessExitStatus=1
NoNewPrivileges=true
ProtectSystem=full
ReadWritePaths=/var/lib/koreader-sync
PrivateTmp=true
